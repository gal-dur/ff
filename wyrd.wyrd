# ff, built and checked by wyrd v4 on its Go toolkit, wyrd://go (wyrd tasks 389, 444): the
# Makefile's `build` and `test`, plus `go vet` and `gofmt` as checks, each check one run per
# package. The toolkit fetches go.mod's modules itself: `--allow-net` once per go.mod change.
#
#     wyrd run test                     # go test, one run per package, coverage folded
#     wyrd run test --RUN TestBuild     # only the tests matching the regexp
#     wyrd run vet fmt                  # the two lint checks
#     wyrd run fmt                      # gofmt, as a draft; `wyrd keep DRAFT` writes it
#     wyrd run build --allow-net        # bin/ff with the llama.cpp runtime embedded
#     wyrd run build --GOOS darwin --GOARCH arm64
#     wyrd run checks                   # every check, one verdict

go = import("wyrd://go")

# describe.sh is the one script left: there is no wyrd://git (wyrd task 390).
_scripts = here / "toolchain" / "wyrd"

# The target platform, linux/amd64 unless given (the Makefile defaults to `uname`'s).
_goos = param("GOOS", "linux")
_goarch = param("GOARCH", "amd64")
# The version the binary reports: `--VERSION`, else what `git describe` says of the repository.
_version = param<String>("VERSION") ?? _describe(script = _scripts.file("describe.sh"), repo = files(".git/**")).version

_describe = tool({
  "doc": "git describe --tags --always of the repository",
  "image": "docker.io/library/golang:1.27",
  "inputs": { "script": File, "repo": Files },
  "outputs": { "version": json<String>("version.json") },
  "entry": ["sh", "/in/script"],
})

# --- checks: one run per package, each keyed by its files and those of the packages it builds --

tests = go.test(src = here, run = param<String>("RUN"))
test = assert(tests.report.ok, tests.report.message ?? "tests failed")

vetted = go.vet(src = here)
vet = assert(vetted.report.ok, vetted.report.message ?? "go vet is red")

fmt = go.fmt(src = here)

# --- build --------------------------------------------------------------------------------------

# The one network step besides the toolkit's fetch: cmd/pin fetches the pinned archive and verifies it
# against internal/pin, built for the host whatever the target; keyed by its sources, so a pin
# bump refetches.
_pinned = go.run_net(
  src = files("go.mod cmd/pin/*.go internal/pin/*.go internal/provision/*.go !**/*_test.go"),
  package = "./cmd/pin",
  args = ["fetch", _goos, _goarch],
)
runtime = (_pinned.files / "internal" / "provision").file("runtime.tar.gz")

# The Makefile's `go build -trimpath -tags embedruntime -ldflags="-s -w -X main.version=…"`, the
# fetched archive placed where runtime_embed.go's go:embed reads it. Tests left out: a new test
# neither rebuilds nor refetches.
build = go.build(
  src = files("go.mod **/*.go !**/*_test.go"),
  package = "./cmd/ff",
  tags = ["embedruntime"],
  goos = _goos,
  goarch = _goarch,
  ldflags = { "main.version": _version },
  trimpath = true,
  strip = true,
  extra = { "internal/provision/runtime.tar.gz": runtime },
)

# --- everything ---------------------------------------------------------------------------------

_checks_report = verdict([tests.report, vetted.report, fmt.report])
checks = assert(_checks_report.ok, _checks_report.message ?? "ff's checks are red")
